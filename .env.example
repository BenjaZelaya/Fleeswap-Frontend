# Variables de entorno para Fleeswap Frontend
#
# DESARROLLO LOCAL:
#   VITE_API_URL=/api          → proxy Vite → localhost:3000
#   VITE_BACKEND_URL=http://localhost:3000   → Socket.IO directo (WS no usa proxy)
#
# PRODUCCIÓN (Vercel Dashboard):
#   VITE_API_URL=https://fleeswap-backend.onrender.com/api
#   VITE_BACKEND_URL=https://fleeswap-backend.onrender.com  ← SIN /api
#

VITE_API_URL=http://localhost:3000/api
VITE_BACKEND_URL=http://localhost:3000
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_FAVICON=
