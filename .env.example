# Variables de entorno para Fleeswap Frontend
#
# DESARROLLO LOCAL:
#   VITE_API_URL=/api
#   VITE_SOCKET_URL=
#   Vite proxyea /api/* y /socket.io/* a http://localhost:3000
#
# PRODUCCIÓN:
#   VITE_API_URL=/api
#   VITE_SOCKET_URL=
#   Configurar el proxy same-origin en Vercel fuera del repo:
#   /api/*       -> backend real /api/*
#   /socket.io/* -> backend real /socket.io/*
#

VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_FAVICON=
